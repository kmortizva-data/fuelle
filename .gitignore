# Datos crudos: se re-descargan de UCI (208 MB), nunca entran al repo
data/

# El lago se reconstruye entero desde data/ corriendo el pipeline
lake/
# Y sus copias mientras se prueba la reconstrucción del módulo 29: reconstruye.py
# aparta el lago a lake_antes/, y lake_original/ guarda el primero de todos.
lake_*/

# Entornos
.venv/
.venv-*/
__pycache__/
*.pyc

# Salidas de dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Sitio construido: se regenera con build_site.py
out/

# El motor SQL del navegador se descarga con un script, no se versiona
assets/duckdb-wasm/

# Windows
Thumbs.db
desktop.ini

# Las fuentes SI se versionan (289 KB): sin ellas el sitio se ve con otra letra
# y deja de parecerse a lo aprobado. El motor SQL no, porque son 35 MB.

# Lo que Dagster escribe al correr (historial, registros, su base interna).
# Su configuración sí se versiona: es la que apaga la telemetría.
dagster_home/*
!dagster_home/dagster.yaml

# El traspaso entre sesiones de trabajo: estado de un día, no parte del proyecto.
HANDOFF.md
